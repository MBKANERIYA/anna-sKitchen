# Copy to .env and fill in. On Hostinger these are set in
# hPanel -> your app -> Environment variables (the panel values win over this file).

# MongoDB Atlas connection string.
# Atlas Network Access must allow your Hostinger server's IP (or 0.0.0.0/0).
MONGODB_URI=

# Cloudinary — used for admin image uploads only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin authentication (required to use the admin dashboard) -------------
# Generate all three values with:  npm run admin:password
#
# If any of these is missing, the admin API fails CLOSED: every login and every
# content change is refused. The public site keeps working normally.

# The admin login name. Anything you like; it does not have to be "admin".
ADMIN_USERNAME=

# scrypt hash of the password, in the form  scrypt$<salt>$<key>
# The plaintext password is never stored anywhere.
ADMIN_PASSWORD_HASH=

# Signing key for session cookies. Minimum 32 characters, random, secret.
# Rotating this immediately signs out every active admin session.
SESSION_SECRET=

# Hostinger injects PORT; only set this for local development.
PORT=5000
NODE_ENV=production
